; ===========================================================================
; BruSafe -- PRODUCTION. CHARMM36m / CHARMM-modified TIP3P, HMR, 4 fs.
; nsteps below is a placeholder: 03_production.sh rewrites it from the ns
; column of config/systems.tsv and the dt in this file.
; This file is IDENTICAL for every system and every replica, including the
; GPU benchmark. If you edit it mid-campaign, timings and energies stop being
; comparable and the campaign is over.
; ===========================================================================

integrator              = md
dt                      = 0.004
; HMR (H ~3 Da) is in the topology, applied by scripts/hmr_top.py in 01_prepare.sh
nsteps                  = 25000000        ; 100 ns @ 4 fs (rewritten per system)
comm-mode               = Linear
nstcomm                 = 100

; ---------- output ----------
nstxout-compressed      = 2500            ; 10 ps -> 100 frames/ns
compressed-x-grps       = System          ; keeps water for bridge analysis;
                                          ; switch to non-Water if disk is tight
nstenergy               = 2500
nstlog                  = 2500
nstcalcenergy           = 100
nstxout                 = 0
nstvout                 = 0
nstfout                 = 0

; ---------- bonds ----------
continuation            = yes
constraint_algorithm    = lincs
constraints             = h-bonds
lincs_iter              = 1
lincs_order             = 4

; ---------- neighbour searching ----------
cutoff-scheme           = Verlet
nstlist                 = 100             ; mdrun auto-tunes upward on GPU
pbc                     = xyz
verlet-buffer-tolerance = 0.005

; ---------- CHARMM36 nonbonded block ----------
coulombtype             = PME
rcoulomb                = 1.2
pme_order               = 4
fourierspacing          = 0.12
vdwtype                 = cutoff
vdw-modifier            = force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
rlist                   = 1.2
DispCorr                = no

; ---------- temperature ----------
tcoupl                  = V-rescale
tc-grps                 = SOLU SOLV       ; index groups built by 01_prepare.sh
tau_t                   = 1.0   1.0
ref_t                   = 310   310

; ---------- pressure ----------
pcoupl                  = C-rescale       ; compatible with mdrun -update gpu
pcoupltype              = isotropic
tau_p                   = 5.0
ref_p                   = 1.0
compressibility         = 4.5e-5

; ---------- velocities ----------
gen_vel                 = no              ; inherited from npt_free
