; BruSafe -- energy minimisation. CHARMM36m / CHARMM-modified TIP3P.
integrator              = steep
emtol                   = 1000.0
emstep                  = 0.01
nsteps                  = 50000

cutoff-scheme           = Verlet
nstlist                 = 10
pbc                     = xyz

coulombtype             = PME
rcoulomb                = 1.2
pme_order               = 4
fourierspacing          = 0.12

; CHARMM36 nonbonded block: identical in every mdp file; any change must be made in all of them
vdwtype                 = cutoff
vdw-modifier            = force-switch
rvdw_switch             = 1.0
rvdw                    = 1.2
rlist                   = 1.2
DispCorr                = no
