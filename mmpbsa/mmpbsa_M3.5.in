; ============================================================================
; M3.5 — CP dimer : pac hairpin binding energetics
; gmx_MMPBSA input (Valdés-Tresanco et al.). Flag names should be checked against
; `gmx_MMPBSA --help` for the installed version, since several changed between
; releases 1.4, 1.5 and 1.6, in particular the entropy keywords.
;
; Run:
;   mpirun -np 8 gmx_MMPBSA MPI -O -i mmpbsa.in \
;     -cs complex.tpr -ci index.ndx -cg <protein_grp> <rna_grp> \
;     -ct complex_nopbc_nowat.xtc -cp topol.top \
;     -o FINAL_RESULTS.dat -eo FINAL_RESULTS.csv \
;     -do FINAL_DECOMP.dat -deo FINAL_DECOMP.csv
;
; Prerequisite: the trajectory must be corrected for periodic boundaries, otherwise the
; energies are meaningless:
;   gmx trjconv -s prod.tpr -f prod.xtc -pbc whole -o w.xtc
;   gmx trjconv -s prod.tpr -f w.xtc  -pbc nojump -o nj.xtc
;   gmx trjconv -s prod.tpr -f nj.xtc -center -pbc mol -ur compact \
;               -n index.ndx -o complex_nopbc.xtc
;   (then strip SOL/ions — implicit solvent, they must not be present)
; ============================================================================

&general
  sys_name              = "CP2_pacWT"
  startframe            = 2500        ; skip the first 50 ns of a 100 ns run
  endframe              = 10000
  interval              = 8           ; ~940 frames; more is not more information
  temperature           = 310.0

  ; --- radii ---
  ; Fixed for this campaign: CHARMM36m -> PBRadii = 7 (charmm_radii).
  ; AMBER ff99SB-ILDN   -> PBRadii = 3  (mbondi2)
  PBRadii               = 7

  ; --- entropy ---
  ; Interaction entropy is inexpensive but noisy for highly charged complexes.
  ; It is computed, reported separately and never folded silently into "ΔG".
  ; Normal-mode entropy (nmode) is not attempted for a system of 258 residues
  ; and 19 nucleotides.
  interaction_entropy   = 1
  ie_segment            = 25
  c2_entropy            = 1

  verbose               = 2
/

; ---------------------------------------------------------------------------
; PB is the primary number for a protein–RNA complex.
; GB is run alongside only as an internal consistency check — generalized Born
; handles the RNA phosphate backbone poorly and tends to inflate electrostatic
; discrimination. If PB and GB disagree by more than a few kcal/mol on ΔΔG,
; neither should be interpreted until the difference is understood.
; ---------------------------------------------------------------------------

&pb
  istrng                = 0.150       ; must match the salt concentration of the MD simulation
  indi                  = 4.0         ; interior dielectric — see note below
  exdi                  = 80.0
  inp                   = 2           ; SASA + dispersion nonpolar model
  radiopt               = 0           ; use the topology radii, not optimised
  fillratio             = 4.0
/

&gb
  igb                   = 2           ; OBC(I)
  saltcon               = 0.150
/

; ---------------------------------------------------------------------------
; Per-residue decomposition is the least expensive validation available. Its hot
; spots should recover the known operator-contact residues of MS2 CP; if they do
; not, the setup is wrong and no ΔG should be interpreted.
; ---------------------------------------------------------------------------

&decomposition
  idecomp               = 2           ; per-residue, backbone/sidechain split
  dec_verbose           = 0
  print_res             = "within 5"
/

; ============================================================================
; SENSITIVITY RUNS (required)
;
; indi (interior dielectric) is the largest single source of uncertainty for a
; charged protein–RNA interface. The whole calculation is repeated at
; indi = 1, 2 and 4, and the spread is reported as part of the error bar. A
; conclusion that changes between indi = 2 and indi = 4 is not robust.
;
; The calculation is also repeated with a shifted startframe (for example
; 5000–10000 against 2500–7500) to show that the estimate does not depend on one
; stretch of the trajectory.
; ============================================================================
