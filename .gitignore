# Never commit trajectories or checkpoints — they are large and regenerable
*.xtc
*.trr
*.cpt
*.edr
*.tpr
*.gro
*.log
#*#
step*.pdb
\#*
runs/
bench_*/
__pycache__/
*.pyc

# DO commit: mdp, scripts, topologies (.top/.itp), index files, analysis output
!*.top
!*.itp
!*.ndx
!*.mdp
!analysis_out/**

# Starting structures and CHARMM-GUI builds ARE inputs: commit them
!input/**/*.gro
!input/**/*.pdb

# local caches
.DS_Store
input/_pdb/

# packed results for upload
pack/
